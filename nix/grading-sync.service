[Unit]
Description=Sync grading repositories and deadline closures
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/grading
EnvironmentFile=/run/grading/compose.env
ExecStart=/usr/bin/docker compose -f /opt/grading/compose.yaml run --rm operator sync
TimeoutStartSec=6h
